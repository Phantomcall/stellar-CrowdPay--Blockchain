# ═══════════════════════════════════════════════════════════════════════════
# CrowdPay backend configuration. THIS FILE IS THE SINGLE SOURCE OF TRUTH.
#
#   cp backend/.env.example backend/.env
#
# Every variable the backend reads is listed here. Uncommented values are
# hard-required (src/config/env.js refuses to start without them) or set to a
# safe local-development default. Commented variables are optional.
#
# The repository-root .env.example only feeds docker compose's ${...}
# substitution (database container credentials) and must stay consistent with
# DATABASE_URL below. src/config/envExample.test.js checks both files.
#
# Values marked DEV-ONLY are published. src/config/env.js refuses to start
# with them when NODE_ENV=production or STELLAR_NETWORK=mainnet.
# ═══════════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Allowed CORS origin, also used to build links in emails
FRONTEND_URL=http://localhost:5173
# Serve frontend/dist from the backend (single-container deployments)
# SERVE_FRONTEND=false
# Minimum log level: error | warn | info | http | debug (default: info)
LOG_LEVEL=info
# Per-module log level overrides, comma-separated name=level pairs.
# Overrides win over LOG_LEVEL for the named module only.
# LOG_LEVEL_MODULES=webhookDispatcher=debug,ledgerMonitor=warn

# ── Database (required) ──────────────────────────────────
# Credentials must match POSTGRES_* in the root .env (docker compose).
# Inside docker compose the backend overrides the host to `db`.
DATABASE_URL=postgres://crowdpay:crowdpay@localhost:5432/crowdpay
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Only read by the postgres container in docker-compose.prod.yml
# (which loads this file); keep in sync with DATABASE_URL.
POSTGRES_DB=crowdpay
POSTGRES_USER=crowdpay
POSTGRES_PASSWORD=crowdpay

# ── Auth (required) ──────────────────────────────────────
# DEV-ONLY. Generate real secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-jwt-secret-change-me
# HMAC pepper for API keys. Must differ from JWT_SECRET. DEV-ONLY.
API_KEY_PEPPER=dev-only-api-key-pepper-change-me
# Access-token lifetime (short-lived; the refresh cookie renews it)
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Stellar (required) ───────────────────────────────────
# 'testnet' or 'mainnet' (any value other than 'mainnet' is treated as testnet)
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# USDC issuer (differs per network)
#   Testnet: GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
#   Mainnet: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Extra credit assets as JSON {"CODE":"ISSUER"}
# STELLAR_EXTRA_ASSETS=
# NGN_ISSUER=

# ── Platform wallet (required) ───────────────────────────
# Platform co-signer secret key. DEV-ONLY testnet key. Generate your own:
#   https://laboratory.stellar.org/#account-creator
PLATFORM_SECRET_KEY=SCVMQUS5EMTHWBLJTE5XCSCMHB2ZOVKRR4ATVTRPUNRCOGKRENIL3LHR
# User ID allowed to co-sign withdrawals and milestone releases.
# Unset = any authenticated user may approve (development only!)
# PLATFORM_APPROVER_USER_ID=
# Platform fee in basis points taken from each contribution (0-10000)
# PLATFORM_FEE_BPS=0

# ── Custodial wallet secret encryption (required) ────────
# 'local' (development) or 'aws-kms' (required when NODE_ENV=production)
WALLET_SECRET_PROVIDER=local
# Base64 or hex encoding of exactly 32 bytes. DEV-ONLY. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WALLET_SECRET_LOCAL_KEK=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# aws-kms provider
# WALLET_SECRET_KMS_KEY_ID=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# WALLET_SECRET_KMS_ENDPOINT_HOST=
# WALLET_SECRET_KMS_ENDPOINT_PATH=/

# ── KYC / identity verification ──────────────────────────
# Defaults to enabled when unset; false skips KYC for testnet / local dev
KYC_REQUIRED_FOR_CAMPAIGNS=false
# KYC_PROVIDER=persona
# PERSONA_API_KEY=
# PERSONA_TEMPLATE_ID=
# Base URL for hosted-KYC redirects (defaults to FRONTEND_URL)
# APP_BASE_URL=
# HMAC secret shared with the KYC provider's webhook settings
# KYC_WEBHOOK_SECRET=

# ── Email ────────────────────────────────────────────────
# With neither SMTP_HOST nor EMAIL_SERVICE_API_KEY set, emails are logged only
# DISABLE_EMAILS=false
# EMAIL_FROM="CrowdPay" <noreply@crowdpay.local>
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=
# EMAIL_SERVICE_API_KEY=
# Shared token for POST /api/webhooks/email-events (bounce/complaint suppression);
# send it as the X-Email-Webhook-Token header or ?token= query param
# EMAIL_WEBHOOK_SECRET=

# ── Anchor / SEP-24 (fiat on-ramp) ───────────────────────
# ANCHOR_WALLET_HOME_DOMAIN=
# ANCHOR_WALLET_SIGNING_SECRET=
# ANCHOR_MONEYGRAM_ENABLED=true
# sandbox | preview | production (defaults from STELLAR_NETWORK)
# ANCHOR_MONEYGRAM_ENV=sandbox

# Custom anchor (optional alternative to MoneyGram)
# ANCHOR_CUSTOM_ID=
# ANCHOR_CUSTOM_NAME=
# ANCHOR_CUSTOM_HOME_DOMAIN=
# ANCHOR_CUSTOM_WEB_AUTH_ENDPOINT=
# ANCHOR_CUSTOM_SEP24_ENDPOINT=
# ANCHOR_CUSTOM_SIGNING_KEY=
# ANCHOR_CUSTOM_ASSET_CODE=
# ANCHOR_CUSTOM_ASSET_ISSUER=
# ANCHOR_CUSTOM_NETWORK=testnet
# ANCHOR_CUSTOM_ENV=production
# ANCHOR_CUSTOM_MARKET=custom
# ANCHOR_CUSTOM_TESTNET=false
# ANCHOR_CUSTOM_RAILS=

# ── Soroban contracts (optional on-chain escrow) ─────────
# ESCROW_WASM_HASH=
# MILESTONES_WASM_HASH=

# ── Object storage (campaign covers) ─────────────────────
# Leave all empty to disable uploads; if any is set, BUCKET and ENDPOINT are required
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# ── Background jobs ──────────────────────────────────────
# ENABLE_CAMPAIGN_STATUS_CRON=true
# ENABLE_RECONCILIATION_CRON=true

# ── Monitoring ───────────────────────────────────────────
# Sentry DSN; empty disables error tracking
SENTRY_DSN=
# Slack-compatible webhook for operational alerts
# ALERT_WEBHOOK_URL=

# Per-account login lockout (in addition to the per-IP login rate limit).
# LOGIN_MAX_FAILURES consecutive failures lock the account for
# LOGIN_LOCK_BASE_MINUTES, doubling on each repeat lock up to LOGIN_LOCK_MAX_MINUTES.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_BASE_MINUTES=15
LOGIN_LOCK_MAX_MINUTES=1440
# Hard cap on password attempts per account per rolling hour (any IP).
LOGIN_MAX_ATTEMPTS_PER_HOUR=20
# Failures within an hour that trigger a security_alert log even before a lock.
LOGIN_BURST_ALERT_THRESHOLD=10
# Max disputes a single user can raise per hour (per-user, not per-IP).
DISPUTE_CREATE_LIMIT_PER_HOUR=5
