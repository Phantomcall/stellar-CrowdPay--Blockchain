server {
  listen 80;
  server_tokens off;
  client_max_body_size 10m;
  root /usr/share/nginx/html;
  index index.html;

  # frame-ancestors allowlist for the embeddable /embed and /widget routes.
  # Override per deployment via the EMBED_FRAME_ANCESTORS env var
  # (comma-separated origins, e.g. "https://partner.com,https://partner.io").
  # Defaults to permitting any embedding origin until an allowlist is set.
  set $embed_frame_ancestors *;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: ${CSP_IMG_HOSTS}; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ${VITE_API_BASE_URL} ${CSP_SENTRY_ORIGIN} ws: wss:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

  location / {
    # SSI splices per-route metadata from /api/seo/head into the SPA shell so
    # crawlers and social scrapers see campaign og/twitter tags without JS.
    ssi on;
    ssi_silent_errors on;  # an unreachable backend must not break page serving
    try_files $uri $uri/ /index.html;  # SPA fallback
  }

  # Embeddable campaign widget: frameable by permitted third-party origins.
  # X-Frame-Options is intentionally omitted from this location — the
  # frame-ancestors allowlist below governs framing instead — while the main
  # app keeps the SAMEORIGIN default defined at server level.
  location /embed/ {
    add_header X-Content-Type-Options "nosniff" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: ${CSP_IMG_HOSTS}; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ${VITE_API_BASE_URL} ${CSP_SENTRY_ORIGIN} ws: wss:; frame-ancestors $embed_frame_ancestors; base-uri 'self'; form-action 'self'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    try_files $uri /embed.html;
  }

  # Compact widget route: served by the SPA but must also be frameable by
  # third-party origins, hence the same frame-ancestors allowlist.
  location /widget/ {
    add_header X-Content-Type-Options "nosniff" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: ${CSP_IMG_HOSTS}; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ${VITE_API_BASE_URL} ${CSP_SENTRY_ORIGIN} ws: wss:; frame-ancestors $embed_frame_ancestors; base-uri 'self'; form-action 'self'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    try_files $uri /index.html;
  }

  location /api/ {
    proxy_pass http://backend:3001;    # forward API calls to backend service
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    proxy_connect_timeout 10s;
  }
}
